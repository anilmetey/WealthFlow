@model IEnumerable<WealthFlow.Application.DTOs.TransactionDto>
@{
    ViewData["Title"] = "İşlemler";
    ViewData["PageTitle"] = "İşlem Defteri";
}

<!-- Filters Section -->
<div class="glass-card mb-4 border-glow">
    <form id="filterForm" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label text-muted fs-8">Açıklamada Ara</label>
            <input name="searchTerm" class="form-control" placeholder="Anahtar kelime..." value="@ViewBag.SearchTerm" />
        </div>
        
        <div class="col-md-3">
            <label class="form-label text-muted fs-8">Kategori</label>
            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">Tüm Kategoriler</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label text-muted fs-8">İşlem Türü</label>
            <select name="type" class="form-select">
                <option value="">Tümü</option>
                <option value="Expense" selected="@(ViewBag.SelectedType?.ToString() == "Expense" ? "selected" : null)">Gider</option>
                <option value="Income" selected="@(ViewBag.SelectedType?.ToString() == "Income" ? "selected" : null)">Gelir</option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-indigo flex-grow-1">
                <i class="fa-solid fa-filter me-2"></i>Filtrele
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="resetFilters()">Temizle</button>
        </div>
    </form>
</div>

<!-- Transactions Table Card -->
<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="card-title-custom">İşlem Kayıtları</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="exportTransactionsToCSV()">
                <i class="fa-solid fa-file-csv me-1 text-success"></i> CSV Dışa Aktar
            </button>
            <button class="btn btn-indigo btn-sm" onclick="openTransactionModalForCreate()">
                <i class="fa-solid fa-plus me-1"></i> Yeni İşlem Ekle
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table custom-table table-hover align-middle" id="transactionsTable">
            <thead>
                <tr>
                    <th>Açıklama</th>
                    <th>Cüzdan/Hesap</th>
                    <th>Kategori</th>
                    <th>Tarih</th>
                    <th>Tür</th>
                    <th class="text-end">Tutar</th>
                    <th class="text-center" style="width: 120px;">İşlemler</th>
                </tr>
            </thead>
            <tbody id="transactionsTableBody">
                @foreach (var item in Model)
                {
                    <tr id="row-@item.Id">
                        <td>
                            <span class="text-white fw-medium">@item.Description</span>
                        </td>
                        <td>
                            <span class="badge bg-dark border text-muted fs-8" style="border-color: rgba(255,255,255,0.06) !important;">
                                @(item.WalletName ?? "Nakit")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="category-indicator-dot me-2" style="background-color: @(item.CategoryColor ?? "#6B7280");"></span>
                                <span>@(item.CategoryName ?? "Kategorisiz")</span>
                            </div>
                        </td>
                        <td>
                            <span class="text-muted">@item.Date.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span>
                        </td>
                        <td>
                            @if (item.Type == TransactionType.Income)
                            {
                                <span class="badge badge-success-soft text-success">Gelir</span>
                            }
                            else
                            {
                                <span class="badge badge-danger-soft text-danger">Gider</span>
                            }
                        </td>
                        <td class="text-end">
                            <span class="fw-bold @(item.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                @(item.Type == TransactionType.Income ? "+" : "-")@item.Amount.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-icon btn-sm btn-outline-info" title="Düzenle" onclick="openTransactionModalForEdit(@item.Id)">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button type="button" class="btn btn-icon btn-sm btn-outline-danger" title="Sil" onclick="deleteTransaction(@item.Id)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Transaction Create/Edit Dynamic Modal -->
<div class="modal fade custom-modal" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="transactionModalLabel">İşlem Detayları</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="transactionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="txId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <input name="Description" id="txDescription" class="form-control" placeholder="Örn: Market Alışverişi, Maaş Ödemesi" required maxlength="100" />
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Miktar (₺)</label>
                            <input name="Amount" id="txAmount" type="number" step="0.01" class="form-control" placeholder="0.00" required min="0.01" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tarih</label>
                            <input name="Date" id="txDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">İşlem Türü</label>
                            <select name="Type" id="txType" class="form-select" required>
                                <option value="1">Gider (Çıkış)</option>
                                <option value="0">Gelir (Giriş)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Cüzdan / Hesap</label>
                            <select name="WalletId" id="txWalletId" class="form-select" required>
                                <option value="">Yükleniyor...</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Kategori</label>
                        <select name="CategoryId" id="txCategoryId" class="form-select" required>
                            <option value="">Yükleniyor...</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-indigo" id="txSaveBtn">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // SPA Router script reload ile uyumlu yapıda
    (function() {
        let isLoaded = false;
        
        function initPage() {
            if (isLoaded) return;
            isLoaded = true;

            // Listen for quick transaction additions
            if (window.onQuickTransactionAddedHandler) {
                document.removeEventListener("transactionAdded", window.onQuickTransactionAddedHandler);
            }
            window.onQuickTransactionAddedHandler = function() {
                if (typeof refreshTransactionsTable === "function") {
                    refreshTransactionsTable();
                }
            };
            document.addEventListener("transactionAdded", window.onQuickTransactionAddedHandler);

            // Kategorileri indir
            fetch('/api/categories')
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('txCategoryId');
                    if (select) {
                        select.innerHTML = '<option value="">Seçiniz...</option>';
                        data.forEach(cat => {
                            select.innerHTML += `<option value="${cat.id}">${cat.name}</option>`;
                        });
                    }
                });

            // Cüzdanları indir
            fetch('/api/wallets')
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('txWalletId');
                    if (select) {
                        select.innerHTML = '<option value="">Seçiniz...</option>';
                        data.forEach(w => {
                            select.innerHTML += `<option value="${w.id}">${w.name} (${w.balance.toLocaleString('tr-TR')} ₺)</option>`;
                        });
                    }
                });

            // Form Submit Dinleyicisi
            const form = document.getElementById('transactionForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    saveTransaction();
                });
            }

            // Filtreleme Dinleyicisi (Anlık Arama ve Debounce Filtre)
            const filterForm = document.getElementById('filterForm');
            if (filterForm) {
                filterForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    refreshTransactionsTable();
                });

                const searchInput = filterForm.querySelector('input[name="searchTerm"]');
                const categorySelect = filterForm.querySelector('select[name="categoryId"]');
                const typeSelect = filterForm.querySelector('select[name="type"]');
                
                let searchTimeout = null;
                if (searchInput) {
                    searchInput.addEventListener('input', function() {
                        clearTimeout(searchTimeout);
                        searchTimeout = setTimeout(refreshTransactionsTable, 250); // 250ms debounce
                    });
                }
                
                if (categorySelect) {
                    categorySelect.addEventListener('change', refreshTransactionsTable);
                }
                if (typeSelect) {
                    typeSelect.addEventListener('change', refreshTransactionsTable);
                }
            }
        }

        initPage();

        window.resetFilters = function() {
            document.getElementById('filterForm').reset();
            refreshTransactionsTable();
        };

        function refreshTransactionsTable() {
            const formData = new FormData(document.getElementById('filterForm'));
            const search = formData.get('searchTerm') || '';
            const category = formData.get('categoryId') || '';
            const type = formData.get('type') || '';

            let url = `/api/transactions?searchTerm=${encodeURIComponent(search)}`;
            if (category) url += `&categoryId=${category}`;
            if (type) {
                url += `&type=${type === 'Income' ? 0 : 1}`;
            }

            fetch(url)
                .then(res => res.json())
                .then(data => {
                    renderTransactionsTableRows(data);
                })
                .catch(err => console.error(err));
        }

        function renderTransactionsTableRows(data) {
            const tbody = document.getElementById('transactionsTableBody');
            tbody.innerHTML = '';

            if (data.length > 0) {
                const formatter = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' });

                data.forEach(item => {
                    const typeText = item.type === 0 ? 'Gelir' : 'Gider';
                    const typeBadge = item.type === 0 ? 'badge-success-soft text-success' : 'badge-danger-soft text-danger';
                    const typeSign = item.type === 0 ? '+' : '-';
                    const typeColor = item.type === 0 ? 'text-success' : 'text-danger';
                    
                    const dateFormatted = new Date(item.date).toLocaleDateString('tr-TR', { day: '2-digit', month: 'short', year: 'numeric' });

                    tbody.innerHTML += `
                        <tr id="row-${item.id}">
                            <td><span class="text-white fw-medium">${item.description}</span></td>
                            <td>
                                <span class="badge bg-dark border text-muted fs-8" style="border-color: rgba(255,255,255,0.06) !important;">
                                    ${item.walletName || 'Nakit'}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="category-indicator-dot me-2" style="background-color: ${item.categoryColor || '#6B7280'};"></span>
                                    <span>${item.categoryName || 'Kategorisiz'}</span>
                                </div>
                            </td>
                            <td><span class="text-muted">${dateFormatted}</span></td>
                            <td><span class="badge ${typeBadge}">${typeText}</span></td>
                            <td class="text-end">
                                <span class="fw-bold ${typeColor}">${typeSign}${formatter.format(item.amount)}</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button" class="btn btn-icon btn-sm btn-outline-info" title="Düzenle" onclick="openTransactionModalForEdit(${item.id})">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm btn-outline-danger" title="Sil" onclick="deleteTransaction(${item.id})">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });
            } else {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-receipt fs-1 mb-2 opacity-50"></i>
                            <p>Aradığınız kriterlere uygun işlem bulunamadı.</p>
                        </td>
                    </tr>
                `;
            }
        }

        window.exportTransactionsToCSV = function() {
            const formData = new FormData(document.getElementById('filterForm'));
            const search = formData.get('searchTerm') || '';
            const category = formData.get('categoryId') || '';
            const type = formData.get('type') || '';

            let url = `/api/transactions/export?searchTerm=${encodeURIComponent(search)}`;
            if (category) url += `&categoryId=${category}`;
            if (type) {
                url += `&type=${type === 'Income' ? 0 : 1}`;
            }

            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', 'WealthFlow_Islem_Defteri.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        window.openTransactionModalForCreate = function() {
            document.getElementById('transactionModalLabel').textContent = "Yeni İşlem Ekle";
            document.getElementById('txId').value = "";
            document.getElementById('transactionForm').reset();
            document.getElementById('txDate').value = new Date().toISOString().substring(0, 10);
            
            const modal = new bootstrap.Modal(document.getElementById('transactionModal'));
            modal.show();
        };

        window.openTransactionModalForEdit = function(id) {
            document.getElementById('transactionModalLabel').textContent = "İşlemi Düzenle";
            
            fetch(`/api/transactions/${id}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('txId').value = data.id;
                    document.getElementById('txDescription').value = data.description;
                    document.getElementById('txAmount').value = data.amount;
                    document.getElementById('txDate').value = data.date.substring(0, 10);
                    document.getElementById('txType').value = data.type;
                    document.getElementById('txWalletId').value = data.walletId;
                    document.getElementById('txCategoryId').value = data.categoryId;

                    const modal = new bootstrap.Modal(document.getElementById('transactionModal'));
                    modal.show();
                })
                .catch(err => console.error(err));
        };

        function saveTransaction() {
            const id = document.getElementById('txId').value;
            const isEdit = id !== "";

            const jsonData = {
                description: document.getElementById('txDescription').value,
                amount: parseFloat(document.getElementById('txAmount').value),
                date: document.getElementById('txDate').value,
                type: parseInt(document.getElementById('txType').value),
                walletId: parseInt(document.getElementById('txWalletId').value),
                categoryId: parseInt(document.getElementById('txCategoryId').value)
            };

            if (isEdit) {
                jsonData.id = parseInt(id);
            }

            const url = isEdit ? `/api/transactions/${id}` : '/api/transactions';
            const method = isEdit ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(jsonData)
            })
            .then(async res => {
                if (res.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('transactionModal')).hide();
                    window.addNotification(isEdit ? "İşlem başarıyla güncellendi!" : "İşlem başarıyla eklendi!", 'success');
                    refreshTransactionsTable();
                    
                    // Sayfa yenilemeden dashboard/ledger verilerini güncelle
                    const event = new CustomEvent("transactionAdded");
                    document.dispatchEvent(event);
                    if (typeof window.loadLayoutWallets === "function") {
                        window.loadLayoutWallets();
                    }
                } else {
                    const err = await res.json();
                    alert(err.errors ? err.errors.join('\n') : "Kaydetme hatası.");
                }
            })
            .catch(err => console.error(err));
        }

        window.deleteTransaction = function(id) {
            if (confirm("Bu harcama kaydını silmek istediğinizden emin misiniz?")) {
                fetch(`/api/transactions/${id}`, { method: 'DELETE' })
                .then(res => {
                    if (res.ok) {
                        window.addNotification("Harcama kaydı başarıyla silindi.", 'info');
                        refreshTransactionsTable();
                        
                        // Sayfa yenilemeden dashboard/ledger verilerini güncelle
                        const event = new CustomEvent("transactionAdded");
                        document.dispatchEvent(event);
                        if (typeof window.loadLayoutWallets === "function") {
                            window.loadLayoutWallets();
                        }
                    } else {
                        alert("İşlem silinemedi.");
                    }
                })
                .catch(err => console.error(err));
            }
        };
    })();
</script>
