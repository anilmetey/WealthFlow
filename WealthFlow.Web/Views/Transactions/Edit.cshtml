@model WealthFlow.Application.DTOs.TransactionDto
@{
    ViewData["Title"] = "İşlemi Düzenle";
    ViewData["PageTitle"] = "İşlem Güncelle";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="glass-card">
            <h2 class="card-title-custom mb-4">İşlem Detayları</h2>
            
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger fs-8"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Amount" class="form-label">Tutar (₺)</label>
                        <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Date" class="form-label">Tarih</label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger fs-8"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Type" class="form-label">İşlem Türü</label>
                        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<TransactionType>()"></select>
                        <span asp-validation-for="Type" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoryId" class="form-label">Kategori</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="">Kategori Seçin</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger fs-8"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="WalletId" class="form-label">Cüzdan</label>
                        <select asp-for="WalletId" class="form-select" asp-items="ViewBag.WalletId">
                            <option value="">Cüzdan Seçin</option>
                        </select>
                        <span asp-validation-for="WalletId" class="text-danger fs-8"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-indigo px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
