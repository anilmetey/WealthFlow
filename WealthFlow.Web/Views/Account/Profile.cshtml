@{
    ViewData["Title"] = "Profil";
    ViewData["PageTitle"] = "Profil Yönetimi";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="glass-card">
            <h2 class="card-title-custom mb-4">Profil Bilgilerinizi Güncelleyin</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 bg-success-soft text-success fs-8 rounded p-3 mb-4" style="background: rgba(16, 185, 129, 0.08);">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 bg-danger-soft text-danger fs-8 rounded p-3 mb-4" style="background: rgba(239, 68, 68, 0.08);">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Lütfen aşağıdaki hataları giderin:
                        <div asp-validation-summary="All" class="mt-2 text-danger ps-3" style="list-style-type: disc;"></div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label text-muted fs-8">Ad Soyad</label>
                    <input type="text" name="name" class="form-control" value="@ViewBag.UserName" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8">E-posta Adresi</label>
                    <input type="email" name="email" class="form-control" value="@ViewBag.UserEmail" required />
                </div>

                <hr class="my-4 border-secondary opacity-25" />
                <h5 class="text-white fs-7 fw-bold mb-3"><i class="fa-solid fa-key text-indigo me-2"></i>Şifre Değiştir</h5>
                <p class="text-muted fs-9 mb-3">Şifrenizi değiştirmek istemiyorsanız aşağıdaki alanları boş bırakabilirsiniz.</p>

                <div class="mb-3">
                    <label class="form-label text-muted fs-8">Mevcut Şifre</label>
                    <input type="password" name="currentPassword" class="form-control" placeholder="Mevcut Şifre" autocomplete="off" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted fs-8">Yeni Şifre</label>
                        <input type="password" name="newPassword" class="form-control" placeholder="Yeni Şifre" autocomplete="off" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted fs-8">Yeni Şifre Tekrar</label>
                        <input type="password" name="newPasswordConfirm" class="form-control" placeholder="Yeni Şifre Tekrar" autocomplete="off" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-indigo px-4">Profilimi Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
