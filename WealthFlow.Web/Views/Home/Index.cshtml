        function fetchLiveMarketRates() {
            fetch('https://api.exchangerate-api.com/v4/latest/USD')
                .then(res => {
                    if (!res.ok) throw new Error("Currency rates API error");
                    return res.json();
                })
                .then(currencyData => {
                    const usd_try = currencyData.rates.TRY || 45.90;
                    const eur_usd = currencyData.rates.EUR || 0.858;
                    const eur_try = usd_try / eur_usd;
                    
                    usdVal = usd_try;
                    eurVal = eur_try;
                    
                    return fetch('https://api.gold-api.com/price/XAU')
                        .then(res => {
                            if (!res.ok) throw new Error("Gold API error");
                            return res.json();
                        })
                        .then(goldData => {
                            const gold_usd = goldData.price || 4471.0;
                            const gold_gram_try = (gold_usd / 31.1034768) * usd_try;
                            goldVal = gold_gram_try;
                            
                            usdHistory = [usdVal - 0.15, usdVal - 0.08, usdVal - 0.05, usdVal - 0.02, usdVal + 0.01, usdVal];
                            eurHistory = [eurVal - 0.20, eurVal - 0.12, eurVal - 0.08, eurVal - 0.04, eurVal + 0.02, eurVal];
                            goldHistory = [goldVal - 30.0, goldVal - 15.0, goldVal - 25.0, goldVal - 10.0, goldVal + 5.0, goldVal];
                            
                            if (usdSparklineChart) {
                                usdSparklineChart.data.datasets[0].data = usdHistory;
                                usdSparklineChart.update();
                            }
                            if (eurSparklineChart) {
                                eurSparklineChart.data.datasets[0].data = eurHistory;
                                eurSparklineChart.update();
                            }
                            if (goldSparklineChart) {
                                goldSparklineChart.data.datasets[0].data = goldHistory;
                                goldSparklineChart.update();
                            }

                            updateTickerUI('usd', usdVal, "+0.06%", true);
                            updateTickerUI('eur', eurVal, "-0.01%", false);
                            updateTickerUI('gold', goldVal, "+0.36%", true, true);
                        });
                })
                .catch(err => {
                    console.warn("Canlı döviz/altın fiyatları çekilemedi, varsayılan kurlar kullanılacak:", err);
                    updateTickerUI('usd', usdVal, "+0.06%", true);
                    updateTickerUI('eur', eurVal, "-0.01%", false);
                    updateTickerUI('gold', goldVal, "+0.36%", true, true);
                });
        }

        function startRatesTicker() {
            if (window.wealthflowRatesInterval) {
                clearInterval(window.wealthflowRatesInterval);
            }
            
            window.wealthflowRatesInterval = setInterval(() => {
                // USD
                const usdDiff = (Math.random() - 0.48) * 0.05;
                const usdOld = usdVal;
                usdVal += usdDiff;
                const usdPercent = ((usdVal - 45.90) / 45.90 * 100).toFixed(2);
                updateTickerUI('usd', usdVal, usdPercent, usdVal > usdOld);
                updateSparkline(usdSparklineChart, usdVal);

                // EUR
                const eurDiff = (Math.random() - 0.52) * 0.05;
                const eurOld = eurVal;
                eurVal += eurDiff;
                const eurPercent = ((eurVal - 53.50) / 53.50 * 100).toFixed(2);
                updateTickerUI('eur', eurVal, eurPercent, eurVal > eurOld);
                updateSparkline(eurSparklineChart, eurVal);

                // Gold
                const goldDiff = (Math.random() - 0.45) * 4.0;
                const goldOld = goldVal;
                goldVal += goldDiff;
                const goldPercent = ((goldVal - 6600.0) / 6600.0 * 100).toFixed(2);
                updateTickerUI('gold', goldVal, goldPercent, goldVal > goldOld, true);
                updateSparkline(goldSparklineChart, goldVal);
            }, 4000);
        }

        function updateTickerUI(id, val, pct, isUp, isInt = false) {
            const valueEl = document.getElementById(`${id}-value`);
            const changeEl = document.getElementById(`${id}-change`);
            const cardEl = document.getElementById(`rate-${id}`);
            
            if (!valueEl || !changeEl || !cardEl) return;
            
            valueEl.textContent = isInt 
                ? val.toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + ' ₺'
                : val.toFixed(4) + ' ₺';
                
            changeEl.textContent = (pct >= 0 ? '+' : '') + pct + '%';
            if (pct >= 0) {
                changeEl.className = 'rate-badge text-success fs-9 fw-semibold';
            } else {
                changeEl.className = 'rate-badge text-danger fs-9 fw-semibold';
            }
            
            const flashClass = isUp ? 'rate-tick-up' : 'rate-tick-down';
            cardEl.classList.remove('rate-tick-up', 'rate-tick-down');
            void cardEl.offsetWidth; // trigger reflow
            cardEl.classList.add(flashClass);
        }

        function updateSparkline(chart, newVal) {
            if (!chart) return;
            const data = chart.data.datasets[0].data;
            data.shift();
            data.push(newVal);
            
            const isTrendUp = data[data.length - 1] >= data[0];
            chart.data.datasets[0].borderColor = isTrendUp ? '#10b981' : '#ef4444';
            chart.update();
        }

        function initSimulator() {
            const sliderSavings = document.getElementById('sliderSavings');
            const sliderGrowth = document.getElementById('sliderGrowth');
            const sliderYears = document.getElementById('sliderYears');
            
            if (!sliderSavings) return;
            
            [sliderSavings, sliderGrowth, sliderYears].forEach(slider => {
                slider.addEventListener('input', runSimulation);
            });
            
            runSimulation();
        }

        function runSimulation() {
            const savings = parseFloat(document.getElementById('sliderSavings').value);
            const growth = parseFloat(document.getElementById('sliderGrowth').value) / 100;
            const years = parseInt(document.getElementById('sliderYears').value);
            
            document.getElementById('sliderValSavings').textContent = savings.toLocaleString('tr-TR') + ' ₺';
            document.getElementById('sliderValGrowth').textContent = '%' + (growth * 100).toFixed(0);
            document.getElementById('sliderValYears').textContent = years + ' Yıl';
            
            let principal = 0;
            let futureValue = 0;
            const principalData = [];
            const growthData = [];
            const labels = [];
            
            for (let y = 1; y <= years; y++) {
                for (let m = 0; m < 12; m++) {
                    futureValue = (futureValue + savings) * (1 + growth / 12);
                    principal += savings;
                }
                
                labels.push(`${y}. Yıl`);
                principalData.push(Math.round(principal));
                growthData.push(Math.round(futureValue - principal));
            }
            
            document.getElementById('simValPrincipal').textContent = Math.round(principal).toLocaleString('tr-TR') + ' ₺';
            document.getElementById('simValTotal').textContent = Math.round(futureValue).toLocaleString('tr-TR') + ' ₺';
            
            updateSimChart(labels, principalData, growthData);
        }

        function updateSimChart(labels, principalData, growthData) {
            const canvas = document.getElementById('simChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--color-indigo').trim() || '#6366f1';
            
            if (simChart) {
                simChart.data.labels = labels;
                simChart.data.datasets[0].data = principalData;
                simChart.data.datasets[1].data = growthData;
                simChart.data.datasets[1].backgroundColor = primaryColor;
                simChart.data.datasets[1].borderColor = primaryColor;
                simChart.update();
            } else {
                simChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Toplam Birikim (Anapara)',
                                data: principalData,
                                backgroundColor: 'rgba(255, 255, 255, 0.08)',
                                borderColor: 'rgba(255, 255, 255, 0.15)',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Faiz / Büyüme Getirisi',
                                data: growthData,
                                backgroundColor: primaryColor,
                                borderColor: primaryColor,
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                labels: { color: '#94A3B8', font: { family: 'Inter', size: 10 } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) label += ': ';
                                        if (context.parsed.y !== null) {
                                            label += context.parsed.y.toLocaleString('tr-TR') + ' ₺';
                                        }
                                        return label;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                stacked: true,
                                grid: { display: false },
                                ticks: { color: '#94A3B8', font: { family: 'Inter', size: 9 } }
                            },
                            y: {
                                stacked: true,
                                grid: { color: 'rgba(255, 255, 255, 0.03)' },
                                ticks: {
                                    color: '#94A3B8',
                                    font: { family: 'Inter', size: 9 },
                                    callback: function(value) {
                                        return (value / 1000).toLocaleString() + 'k ₺';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }

