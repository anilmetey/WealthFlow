            subs.forEach(s => {
                grid.innerHTML += `
                    <div class="col-md-3">
                        <div class="subscription-card ${s.brandClass}">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="sub-card-logo-container">
                                    <i class="fa-solid ${s.icon}"></i>
                                </div>
                                <button class="btn-simulate-cancel" data-name="${s.name}" data-amount="${s.amount}">İptal Simüle Et</button>
                            </div>
                            <h4 class="text-white fs-8 fw-bold mb-1">${s.name}</h4>
                            <div class="text-muted fs-9 mb-1">Tutar: <span class="text-white fw-semibold">${s.amount} ₺ / ay</span></div>
                            <div class="text-muted-dark fs-9">Sonraki Ödeme: ${s.nextPaymentDate}</div>
                        </div>
                    </div>
                `;
            });

            // Event listener'ları bağla
            const buttons = grid.querySelectorAll('.btn-simulate-cancel');
            buttons.forEach(btn => {
