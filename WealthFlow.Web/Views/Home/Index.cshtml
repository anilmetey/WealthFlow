        window.startEditWallet = function(id) {
            const w = managerWalletsCached.find(x => x.id === id);
            if (!w) return;

            document.getElementById('walletFormTitle').textContent = 'Cüzdanı Düzenle';
            document.getElementById('walletFormId').value = w.id;
            document.getElementById('walletFormName').value = w.name;
            document.getElementById('walletFormBalance').value = w.balance;
            document.getElementById('walletFormColor').value = w.color;
            document.getElementById('walletFormIcon').value = w.icon;

            document.getElementById('walletFormSubmitBtn').textContent = 'Güncelle';
            document.getElementById('walletFormCancelBtn').style.setProperty('display', 'inline-block', 'important');
        };

        window.cancelWalletEdit = function() {
            document.getElementById('walletFormTitle').textContent = 'Yeni Cüzdan Ekle';
            document.getElementById('walletFormId').value = '';
            document.getElementById('walletForm').reset();

            document.getElementById('walletFormSubmitBtn').textContent = 'Ekle';
            document.getElementById('walletFormCancelBtn').style.setProperty('display', 'none', 'important');
        };

        window.deleteWallet = function(id) {
            if (confirm("Bu cüzdanı silmek istediğinizden emin misiniz? Bu cüzdana ait tüm işlemler de silinecektir.")) {
                fetch(`/api/wallets/${id}`, {
                    method: 'DELETE'
                })
                .then(res => {
                    if (res.ok) {
                        window.addNotification("Cüzdan başarıyla silindi.", 'info');
                        loadManagerWallets();
                        refreshDashboard();
                        if (typeof window.loadLayoutWallets === "function") {
                            window.loadLayoutWallets();
                        }
                    } else {
                        alert("Cüzdan silinemedi.");
                    }
                })
                .catch(err => console.error(err));
            }
        };

        function setupWalletManagerForm() {
            const walletForm = document.getElementById('walletForm');
            if (walletForm) {
                walletForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    const submitBtn = document.getElementById('walletFormSubmitBtn');
                    if (submitBtn) submitBtn.disabled = true;
                    
                    const idVal = document.getElementById('walletFormId').value;
                    const isEdit = idVal !== "";
                    
                    const walletData = {
                        name: document.getElementById('walletFormName').value,
                        balance: parseFloat(document.getElementById('walletFormBalance').value),
                        color: document.getElementById('walletFormColor').value,
                        icon: document.getElementById('walletFormIcon').value
                    };

                    if (isEdit) {
                        walletData.id = parseInt(idVal);
                    }

                    const url = isEdit ? `/api/wallets/${idVal}` : '/api/wallets';
                    const method = isEdit ? 'PUT' : 'POST';

                    fetch(url, {
                        method: method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(walletData)
                    })
                    .then(res => {
                        if (res.ok) {
                            window.addNotification(isEdit ? "Cüzdan başarıyla güncellendi!" : "Cüzdan başarıyla eklendi!", 'success');
                            cancelWalletEdit();
                            loadManagerWallets();
                            refreshDashboard();
                            if (typeof window.loadLayoutWallets === "function") {
                                window.loadLayoutWallets();
                            }
                            
                            // Close the modal on successful add/update
                            const modalEl = document.getElementById('walletManagerModal');
                            if (modalEl) {
                                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                                if (modalInstance) {
                                    modalInstance.hide();
                                }
                            }
                        } else {
                            alert("Cüzdan kaydedilirken bir hata oluştu.");
                        }
                    })
                    .catch(err => console.error(err))
                    .finally(() => {
                        if (submitBtn) submitBtn.disabled = false;
                    });
                });
            }
        }

        // ------------------ PREMIUM WIDGETS SCRIPTS ------------------
        function setupPremiumFeatures() {
            try { initSparklines(); } catch (e) { console.error("Error in initSparklines:", e); }
            try { initSimulator(); } catch (e) { console.error("Error in initSimulator:", e); }
            try {
