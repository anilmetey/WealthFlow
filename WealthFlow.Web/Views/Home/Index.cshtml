        function runBesSimulation() {
            const payment = parseFloat(document.getElementById('besSliderPayment').value);
            const years = parseInt(document.getElementById('besSliderYears').value);
            
            document.getElementById('besSliderValVal').textContent = payment.toLocaleString('tr-TR') + ' ₺';
            document.getElementById('besSliderValYears').textContent = years + ' Yıl';

            fetch(`/api/advanced-finances/bes-simulator?monthlyPayment=${payment}&years=${years}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('besTotalPrincipal').textContent = Math.round(data.totalPrincipal).toLocaleString('tr-TR') + ' ₺';
                    document.getElementById('besTotalGov').textContent = Math.round(data.totalGovContribution).toLocaleString('tr-TR') + ' ₺';
                    document.getElementById('besEstimatedWealth').textContent = Math.round(data.estimatedWealth).toLocaleString('tr-TR') + ' ₺';
                    
                    const labels = data.projections.map(p => `${p.year}. Yıl`);
                    const principalData = data.projections.map(p => Math.round(p.totalPrincipal));
                    const govData = data.projections.map(p => Math.round(p.totalGovContribution));
                    const wealthData = data.projections.map(p => Math.round(p.estimatedWealth));
                    
                    updateBesChart(labels, principalData, govData, wealthData);
                });
        }

        function updateBesChart(labels, principalData, govData, wealthData) {
            const canvas = document.getElementById('besChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            if (besChart) {
                besChart.data.labels = labels;
                besChart.data.datasets[0].data = principalData;
                besChart.data.datasets[1].data = govData;
                besChart.data.datasets[2].data = wealthData;
                besChart.update();
            } else {
                besChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Ana Para',
                                data: principalData,
                                borderColor: 'rgba(255, 255, 255, 0.4)',
                                backgroundColor: 'transparent',
                                borderWidth: 2,
                                tension: 0.3
                            },
                            {
                                label: 'Devlet Katkısı',
                                data: govData,
                                borderColor: '#10b981',
                                backgroundColor: 'transparent',
                                borderWidth: 2,
                                tension: 0.3
                            },
                            {
                                label: 'Tahmini Varlık',
                                data: wealthData,
                                borderColor: '#6366f1',
                                backgroundColor: 'rgba(99, 102, 241, 0.05)',
                                fill: true,
                                borderWidth: 3,
                                tension: 0.3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                labels: { color: '#94a3b8', font: { size: 10 } }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 9 } } },
                            y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#94a3b8', font: { size: 9 } } }
                        }
                    }
                });
            }
        }

        function renderDebtStrategy(strategy) {
            if (!debtPlanData) return;
            
            const explain = document.getElementById('debtStrategyExplain');
            const container = document.getElementById('debtPaydownStepsContainer');
            if (!explain || !container) return;
            
            container.innerHTML = '';
            
            if (strategy === "snowball") {
                explain.innerHTML = `<strong>Snowball (Kartopu) Yöntemi:</strong> Borçlarınızı en küçükten başlayarak kapatırsınız. Bu yöntem psikolojik olarak motivasyon sağlar. Aylık ortalama <strong>${debtPlanData.avgMonthlySavings.toLocaleString('tr-TR')} ₺</strong> tasarrufunuzla borç sırası:`;
                
                if (debtPlanData.snowballSteps.length === 0) {
                    container.innerHTML = '<p class="text-success fs-8">Ödenecek borç yok.</p>';
                } else {
                    debtPlanData.snowballSteps.forEach((step, idx) => {
                        container.innerHTML += `
                            <div class="timeline-step-item">
                                <div>
                                    <span class="text-white fw-bold d-block">${idx + 1}. Adım: ${step.walletName}</span>
                                    <span class="text-muted-dark d-block">Tutar: ${step.amount.toLocaleString('tr-TR')} ₺ | Süre: ${step.months} Ay</span>
                                    <span class="badge bg-indigo-soft text-indigo mt-1" style="font-size: 0.55rem;">${step.strategy}</span>
                                </div>
                            </div>
                        `;
                    });
                }
            } else {
                explain.innerHTML = `<strong>Avalanche (Çığ) Yöntemi:</strong> Faiz oranı en yüksek olan borçtan başlarsınız. Matematiksel olarak en az faizi ödeyeceğiniz yöntemdir. Aylık ortalama <strong>${debtPlanData.avgMonthlySavings.toLocaleString('tr-TR')} ₺</strong> tasarrufunuzla borç sırası:`;
                
                if (debtPlanData.avalancheSteps.length === 0) {
                    container.innerHTML = '<p class="text-success fs-8">Ödenecek borç yok.</p>';
                } else {
                    debtPlanData.avalancheSteps.forEach((step, idx) => {
                        container.innerHTML += `
                            <div class="timeline-step-item">
                                <div>
                                    <span class="text-white fw-bold d-block">${idx + 1}. Adım: ${step.walletName}</span>
                                    <span class="text-muted-dark d-block">Tutar: ${step.amount.toLocaleString('tr-TR')} ₺ | Yıllık Faiz: %${step.interestRate} | Süre: ${step.months} Ay</span>
                                    <span class="badge bg-danger-soft text-danger mt-1" style="font-size: 0.55rem;">${step.strategy}</span>
                                </div>
                            </div>
                        `;
                    });
                }
            }
        }

        function drawExposureChart(tryAssets, usdAssets, goldAssets) {
            const canvas = document.getElementById('exposureChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            if (exposureChart) {
                exposureChart.data.datasets[0].data = [tryAssets, usdAssets, goldAssets];
                exposureChart.update();
            } else {
                exposureChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['TL Varlık', 'Döviz (USD/EUR)', 'Altın'],
                        datasets: [{
                            data: [tryAssets, usdAssets, goldAssets],
                            backgroundColor: ['#ef4444', '#3b82f6', '#f59e0b'],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        cutout: '75%'
                    }
                });
            }
        }

        setupPremiumFeatures();
    })();
</script>
