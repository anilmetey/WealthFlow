<script>
    // MVC SPA Script tetikleme uyumluluğu için
    (function() {
        let trendChart = null;
        let categoryChart = null;
        let assetAllocationChart = null;
        let simChart = null;
        let usdSparklineChart = null;
        let eurSparklineChart = null;
        let goldSparklineChart = null;

        let usdHistory = [45.72, 45.78, 45.82, 45.85, 45.88, 45.90];
        let eurHistory = [53.25, 53.32, 53.40, 53.45, 53.48, 53.50];
        let goldHistory = [6510.0, 6535.0, 6560.0, 6580.0, 6590.0, 6600.0];

        let usdVal = 45.9000;
        let eurVal = 53.5000;
        let goldVal = 6600.00;

        const today = new Date();
        const month = today.getMonth() + 1;
        const year = today.getFullYear();

        // Sayfa yüklendiğinde veya event tetiklendiğinde dashboard'ı doldur
        function refreshDashboard() {
            // 1. Ana Dashboard API'si
            fetch(`/api/dashboard?month=${month}&year=${year}`)
                .then(res => res.json())
                .then(data => {
                    hydrateSummaryCards(data);
                    drawTrendChart(data);
                    drawCategoryChart(data);
                    drawAssetAllocationChart(data);
                    hydrateRecentTransactions(data);
                    hydrateBudgets(data);
                });

            // 2. Cüzdanlar
            fetch('/api/wallets')
                .then(res => res.json())
                .then(wallets => {
                    hydrateWallets(wallets);
                    populateTransferModalSelects(wallets);
                });

            // 3. Akıllı Finansal Öneriler
            fetch(`/api/insights?month=${month}&year=${year}`)
                .then(res => res.json())
                .then(insights => {
                    hydrateInsights(insights);
                });

            // 4. Hedefler
            fetch('/api/goals')
                .then(res => res.json())
                .then(goals => {
                    hydrateGoalsList(goals);
                    runSimulationEta([]); // Load original ETAs on load
                });

            // 5. Finansal Sağlık Skoru
            fetch('/api/insights/health-score')
                .then(res => res.json())
                .then(data => {
                    hydrateHealthScore(data.score);
                });

            // 6. Abonelikler
            fetch('/api/subscriptions')
                .then(res => res.json())
                .then(subs => {
                    hydrateSubscriptions(subs);
                });

            // 7. Gelişmiş Finansal Modüller
            if (typeof refreshAdvancedFinances === "function") {
                refreshAdvancedFinances();
            }
        }

        // Clean up previous event listener if it exists
        if (window.onTransactionAddedHandler) {
            document.removeEventListener("transactionAdded", window.onTransactionAddedHandler);
        }
        
        window.onTransactionAddedHandler = function() {
            if (typeof window.refreshDashboardFromHome === "function") {
                window.refreshDashboardFromHome();
            }
        };
        
        document.addEventListener("transactionAdded", window.onTransactionAddedHandler);
        window.refreshDashboardFromHome = refreshDashboard;

        refreshDashboard();

        // ------------------ HYDRATE FUNCTIONS ------------------
        let healthScoreInterval = null;
        function hydrateHealthScore(score) {
            const circle = document.getElementById('healthScoreCircle');
            const text = document.getElementById('healthScoreText');
            const status = document.getElementById('healthScoreStatus');
            
            if (!circle || !text || !status) return;
            
            if (healthScoreInterval) clearInterval(healthScoreInterval);
            
            let currentScore = 0;
            healthScoreInterval = setInterval(() => {
                if (currentScore >= score) {
                    clearInterval(healthScoreInterval);
                    text.textContent = score;
                } else {
                    currentScore += Math.ceil((score - currentScore) / 5) || 1;
                    if (currentScore > score) currentScore = score;
                    text.textContent = currentScore;
                }
            }, 30);
            
            circle.setAttribute('stroke-dasharray', `${score}, 100`);
            
            let color = '#6366f1';
            let textStatus = 'Finansal Durumunuz Stabil.';
            
            const activeAccent = localStorage.getItem("wealthflow_accent") || "indigo";
            const themes = {
                indigo: "#6366f1",
                emerald: "#10b981",
                cyan: "#06b6d4",
                rose: "#f43f5e"
            };
            const themeColor = themes[activeAccent] || themes.indigo;
            
            if (score >= 80) {
                color = '#10B981';
                textStatus = 'Mükemmel Finansal Sağlık! 🚀';
            } else if (score >= 60) {
