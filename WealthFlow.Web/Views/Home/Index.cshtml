        function initSparklines() {
            const getSparklineConfig = (data, color) => ({
                type: 'line',
                data: {
                    labels: [1, 2, 3, 4, 5, 6, 7],
                    datasets: [{
                        data: data,
                        borderColor: color,
                        borderWidth: 1.5,
                        fill: false,
                        tension: 0.3,
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { enabled: false } },
                    scales: {
                        x: { display: false },
                        y: { display: false }
                    }
                }
            });

            try {
                const usdCtx = document.getElementById('usdSparkline').getContext('2d');
                usdSparklineChart = new Chart(usdCtx, getSparklineConfig(usdHistory, '#10b981'));

                const eurCtx = document.getElementById('eurSparkline').getContext('2d');
                eurSparklineChart = new Chart(eurCtx, getSparklineConfig(eurHistory, '#ef4444'));

                const goldCtx = document.getElementById('goldSparkline').getContext('2d');
                goldSparklineChart = new Chart(goldCtx, getSparklineConfig(goldHistory, '#10b981'));
