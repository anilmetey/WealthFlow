        function hydrateSubscriptions(subs) {
            const card = document.getElementById('subscriptionsCard');
            if (!card) return;
            card.classList.remove('skeleton-card');
            card.querySelector('.skeleton-list').style.display = 'none';
            const grid = document.getElementById('subscriptionsGrid');
