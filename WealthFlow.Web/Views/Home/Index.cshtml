                return;
            }

            fetch(`/api/goals/${id}/contribute`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(amount)
            })
            .then(res => {
                if (res.ok) {
                    window.addNotification(`"${title}" hedefine ${amount} ₺ başarıyla aktarıldı!`, 'success');
                    refreshDashboard();
                } else {
                    alert("Para ekleme başarısız.");
                }
            });
        };

