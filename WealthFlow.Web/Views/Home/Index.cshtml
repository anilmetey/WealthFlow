        // Bakiye Transfer Formu Submit (AJAX)
        document.getElementById('transferForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const transferData = {
                fromWalletId: parseInt(formData.get('FromWalletId')),
                toWalletId: parseInt(formData.get('ToWalletId')),
                amount: parseFloat(formData.get('Amount'))
            };

            if (transferData.fromWalletId === transferData.toWalletId) {
                alert("Aynı cüzdanlar arasında transfer yapılamaz.");
                return;
            }

            fetch('/api/wallets/transfer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(transferData)
            })
            .then(async res => {
                const data = await res.json();
                if (res.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('transferModal')).hide();
                    this.reset();
                    window.addNotification(data.message, 'success');
                    refreshDashboard();
                } else {
                    alert(data.message || "Transfer başarısız.");
                }
            })
            .catch(err => console.error(err));
        });

