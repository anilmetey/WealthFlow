                    const name = this.getAttribute('data-name');
                    const isSimulated = this.classList.toggle('simulated-active');
                    
                    if (isSimulated) {
                        this.textContent = 'Simüle Edildi 🚫';
                        activeCancelledSubs.push(name);
                    } else {
                        this.textContent = 'İptal Simüle Et';
                        activeCancelledSubs = activeCancelledSubs.filter(n => n !== name);
                    }

                    runSimulationEta(activeCancelledSubs);
                });
            });
        }

        function runSimulationEta(cancelledNames) {
            fetch('/api/subscriptions/simulate-eta', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cancelledNames: cancelledNames })
            })
            .then(res => res.json())
            .then(data => {
                // Simülasyon Tasarrufu badge'ini güncelle
                document.getElementById('simSavingsTotal').textContent = data.cancelledTotal.toLocaleString('tr-TR') + ' ₺';
                
                // Hedeflerin ETA yazılarını güncelle
                data.results.forEach(r => {
                    const etaTextEl = document.getElementById(`goal-eta-${r.goalId}`);
                    if (etaTextEl) {
                        const originalText = etaTextEl.textContent;
                        let newText = `AI ETA: ${r.newEta}`;
                        if (r.monthsSaved > 0) {
                            newText += ` (🎉 ${r.monthsSaved} Ay Kazanç!)`;
                        }
                        etaTextEl.textContent = newText;
                        
                        // Flashing animation trigger
                        if (originalText !== newText) {
                            etaTextEl.classList.remove('eta-highlight-saved');
                            void etaTextEl.offsetWidth; // Reflow trigger
                            etaTextEl.classList.add('eta-highlight-saved');
                        }
                    }
                });
            })
            .catch(err => console.error("Simülasyon hatası:", err));
        }

        function formatMarkdown(text) {
            if (!text) return "";
            let html = text;
            // Format Headings (### Title)
            html = html.replace(/^### (.*$)/gim, '<h4 class="fs-8 fw-bold mt-2 text-indigo">$1</h4>');
            // Format Bold (**text**)
            html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            // Format Bullet points (* or - item with optional leading spaces)
            html = html.replace(/^\s*[\*\-] (.*$)/gim, '<li>$1</li>');
            html = html.replace(/<li>(.*?)<\/li>/g, '<ul><li>$1</li></ul>');
            html = html.replace(/<\/ul>\s*<ul>/g, ''); // Clean consecutive <ul> tags
            return html;
        }

        function setupWealthyChatbot() {
            const toggleBtn = document.getElementById('wealthyChatToggleBtn');
            const chatWindow = document.getElementById('wealthyChatWindow');
            const closeBtn = document.getElementById('wealthyChatCloseBtn');
            const chatForm = document.getElementById('wealthyChatForm');
            const chatInput = document.getElementById('wealthyChatInput');
            const messagesContainer = document.getElementById('wealthyChatMessages');

            if (!toggleBtn || !chatWindow) return;

            toggleBtn.addEventListener('click', () => {
                chatWindow.classList.toggle('active');
                if (chatWindow.classList.contains('active')) {
                    chatInput.focus();
                    scrollToBottom();
                }
            });

            closeBtn.addEventListener('click', () => {
                chatWindow.classList.remove('active');
            });

            // Quick queries click actions
            document.addEventListener('click', (e) => {
                const quickQueryBtn = e.target.closest('.chat-quick-query');
                if (quickQueryBtn) {
                    const query = quickQueryBtn.getAttribute('data-query');
                    chatInput.value = query;
                    chatForm.dispatchEvent(new Event('submit'));
                }
            });

            chatForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const text = chatInput.value.trim();
                if (!text) return;

                // User message append
                appendMessage(text, 'user');
                chatInput.value = '';
                scrollToBottom();

                // Append typing indicator
                const typingId = appendTypingIndicator();
                scrollToBottom();

                // POST query
                fetch('/api/insights/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                })
                .then(res => res.json())
                .then(data => {
                    removeTypingIndicator(typingId);
                    appendMessage(data.response, 'bot', true);
                    scrollToBottom();
                })
                .catch(err => {
                    removeTypingIndicator(typingId);
                    appendMessage("Bir hata oluştu, lütfen daha sonra tekrar deneyin.", 'bot');
                    scrollToBottom();
                    console.error(err);
                });
            });

            function appendMessage(content, sender, isMarkdown = false) {
                const bubble = document.createElement('div');
                bubble.classList.add('chat-bubble', sender);
                if (isMarkdown) {
                    bubble.innerHTML = formatMarkdown(content);
                } else {
                    bubble.textContent = content;
                }
                messagesContainer.appendChild(bubble);
            }

            function appendTypingIndicator() {
                const indicatorId = 'typing-' + Date.now();
                const wrapper = document.createElement('div');
                wrapper.id = indicatorId;
                wrapper.classList.add('chat-bubble', 'bot');
                wrapper.innerHTML = `
                    <div class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                `;
                messagesContainer.appendChild(wrapper);
                return indicatorId;
            }

            function removeTypingIndicator(id) {
                const el = document.getElementById(id);
                if (el) el.remove();
            }

            function scrollToBottom() {
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }
        }

