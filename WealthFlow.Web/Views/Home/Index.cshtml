                    document.getElementById('exposureGoldVal').textContent = data.goldAssets.toLocaleString('tr-TR', { maximumFractionDigits: 0 }) + ' ₺';
                    
                    drawExposureChart(data.tryAssets, data.usdAssets, data.goldAssets);
