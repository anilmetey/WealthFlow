@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Finansal Özet";
}

<!-- Canlı Döviz Bandı -->
<div class="row mb-4">
    <div class="col-12">
        <div class="glass-card border-glow p-2 d-flex justify-content-between align-items-center flex-wrap gap-3" style="border-radius: 12px; background: rgba(13, 16, 30, 0.45); border: 1px solid rgba(255,255,255,0.03) !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-globe text-muted fs-7"></i>
                <span class="text-muted fs-8 fw-semibold uppercase" style="letter-spacing: 0.5px; font-size: 0.65rem;">Piyasa Kurları:</span>
            </div>
            
            <!-- USD Card -->
            <div class="d-flex align-items-center gap-3 px-3 py-1 rounded" id="rate-usd" style="min-width: 220px; transition: background-color 0.5s ease; background: transparent; border: none !important;">
                <div class="category-icon-wrapper bg-indigo-soft text-indigo" style="width: 28px; height: 28px; border-radius: 6px;">
                    <i class="fa-solid fa-dollar-sign fs-7"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-white fs-8" style="font-size: 0.72rem;">USD/TRY</span>
                        <span class="rate-badge text-success fs-9 fw-semibold" id="usd-change" style="font-size: 0.65rem;">+0.06%</span>
                    </div>
                    <span class="fw-bold fs-7 text-white" id="usd-value" style="font-size: 0.78rem;">45.9000 ₺</span>
                </div>
                <div class="sparkline-container ms-auto">
                    <canvas id="usdSparkline"></canvas>
                </div>
            </div>

            <!-- EUR Card -->
            <div class="d-flex align-items-center gap-3 px-3 py-1 rounded" id="rate-eur" style="min-width: 220px; transition: background-color 0.5s ease; background: transparent; border: none !important;">
                <div class="category-icon-wrapper bg-indigo-soft text-indigo" style="width: 28px; height: 28px; border-radius: 6px;">
                    <i class="fa-solid fa-euro-sign fs-7"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-white fs-8" style="font-size: 0.72rem;">EUR/TRY</span>
                        <span class="rate-badge text-danger fs-9 fw-semibold" id="eur-change" style="font-size: 0.65rem;">-0.01%</span>
                    </div>
                    <span class="fw-bold fs-7 text-white" id="eur-value" style="font-size: 0.78rem;">53.5000 ₺</span>
                </div>
                <div class="sparkline-container ms-auto">
                    <canvas id="eurSparkline"></canvas>
                </div>
            </div>

            <!-- Gold Card -->
            <div class="d-flex align-items-center gap-3 px-3 py-1 rounded" id="rate-gold" style="min-width: 220px; transition: background-color 0.5s ease; background: transparent; border: none !important;">
                <div class="category-icon-wrapper bg-warning-soft text-warning" style="width: 28px; height: 28px; border-radius: 6px;">
                    <i class="fa-solid fa-coins fs-7"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-white fs-8" style="font-size: 0.72rem;">ALTIN (GAU)</span>
                        <span class="rate-badge text-success fs-9 fw-semibold" id="gold-change" style="font-size: 0.65rem;">+0.36%</span>
                    </div>
                    <span class="fw-bold fs-7 text-white" id="gold-value" style="font-size: 0.78rem;">6.600,00 ₺</span>
                </div>
                <div class="sparkline-container ms-auto">
                    <canvas id="goldSparkline"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards (Hydrated via API) -->
<div class="row g-4 mb-4">
    <!-- Net Worth Card -->
    <div class="col-md-3">
        <div class="stat-card glass-card skeleton-card glowing-card-indigo" id="netWorthCard">
            <div class="stat-icon bg-indigo-soft">
                <i class="fa-solid fa-scale-balanced text-indigo"></i>
            </div>
            <div class="stat-details">
                <h3>Net Varlık</h3>
                <div class="skeleton-line w-75 mb-2"></div>
                <p class="stat-value text-data" style="display:none;"></p>
                <span class="stat-subtext text-muted">Toplam bakiye</span>
            </div>
        </div>
    </div>

    <!-- Monthly Income Card -->
    <div class="col-md-3">
        <div class="stat-card glass-card skeleton-card glowing-card-success" id="incomeCard">
            <div class="stat-icon bg-success-soft">
                <i class="fa-solid fa-arrow-trend-up text-success"></i>
            </div>
            <div class="stat-details">
                <h3>Bu Ayki Gelir</h3>
                <div class="skeleton-line w-75 mb-2"></div>
                <p class="stat-value text-success text-data" style="display:none;"></p>
                <span class="stat-subtext text-muted">Bu ay kazanılan</span>
            </div>
        </div>
    </div>

    <!-- Monthly Expense Card -->
    <div class="col-md-3">
        <div class="stat-card glass-card skeleton-card glowing-card-danger" id="expenseCard">
            <div class="stat-icon bg-danger-soft">
                <i class="fa-solid fa-arrow-trend-down text-danger"></i>
            </div>
            <div class="stat-details">
                <h3>Bu Ayki Gider</h3>
                <div class="skeleton-line w-75 mb-2"></div>
                <p class="stat-value text-danger text-data" style="display:none;"></p>
                <span class="stat-subtext text-muted">Bu ay harcanan</span>
            </div>
        </div>
    </div>

    <!-- Savings Rate Card -->
    <div class="col-md-3">
        <div class="stat-card glass-card skeleton-card glowing-card-info" id="savingsCard">
            <div class="stat-icon bg-info-soft">
                <i class="fa-solid fa-piggy-bank text-info"></i>
            </div>
            <div class="stat-details">
                <h3>Tasarruf Oranı</h3>
                <div class="skeleton-line w-50 mb-2"></div>
                <p class="stat-value text-data" style="display:none;"></p>
                <div class="progress custom-mini-progress mt-1" style="display:none;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: 0%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts & Insights Section -->
<div class="row g-4 mb-4">
    <!-- Monthly Trend Chart (8 cols) -->
    <div class="col-lg-8">
        <div class="chart-card glass-card skeleton-card h-100" id="trendChartCard">
            <div class="card-header-custom mb-3">
                <h2 class="card-title-custom">Aylık Nakit Akışı</h2>
                <p class="text-muted">Gelir ve gider karşılaştırması</p>
            </div>
            <div class="skeleton-block h-250 w-100 mb-2"></div>
            <div class="chart-container" style="display:none;">
                <canvas id="cashFlowChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Akıllı Finansal Öneriler & Sağlık Skoru (4 cols) -->
    <div class="col-lg-4 d-flex flex-column gap-4">
        <!-- Finansal Sağlık Skoru Card -->
        <div class="glass-card border-glow text-center p-3 d-flex flex-column align-items-center justify-content-center" id="healthScoreCard" style="height: 190px;">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="card-title-custom fw-bold" style="font-size: 0.8rem; margin: 0;">Finansal Sağlık Skoru</span>
            </div>
            
            <div class="position-relative" style="width: 90px; height: 90px;">
                <svg viewBox="0 0 36 36" class="circular-chart" style="width: 100%; height: 100%; transform: rotate(-90deg);">
                    <path class="circle-bg"
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        style="fill: none; stroke: rgba(255,255,255,0.03); stroke-width: 3;"
                    />
                    <path class="circle-fill"
                        id="healthScoreCircle"
                        stroke-dasharray="0, 100"
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        style="fill: none; stroke: var(--color-indigo); stroke-width: 3; stroke-linecap: round; transition: stroke-dasharray 1s ease-out, stroke 0.5s ease;"
                    />
                </svg>
                <div class="position-absolute top-50 start-50 translate-middle d-flex flex-column align-items-center">
                    <span class="fw-extrabold fs-5 text-white" id="healthScoreText" style="line-height: 1; font-weight: 800; font-family: var(--font-heading);">0</span>
                    <span class="text-muted-dark" style="font-size: 0.55rem; font-weight: 600;">Puan</span>
                </div>
            </div>
            <p class="mb-0 text-muted fs-9 mt-2 fw-medium" id="healthScoreStatus">Hesaplanıyor...</p>
        </div>

        <!-- Akıllı Öneriler Card -->
        <div class="glass-card skeleton-card flex-grow-1 border-glow" id="insightsCard" style="min-height: 220px;">
            <div class="card-header-custom mb-3">
                <h2 class="card-title-custom"><i class="fa-solid fa-lightbulb text-indigo me-2"></i>Finansal Analiz & Öneriler</h2>
                <p class="text-muted">Harcama verilerinize göre analizler</p>
            </div>
            <div class="skeleton-list">
                <div class="skeleton-line mb-3 h-20 w-100"></div>
                <div class="skeleton-line mb-3 h-20 w-100"></div>
            </div>
            <div class="insights-list text-data-list d-flex flex-column gap-2" style="display:none;">
                <!-- Loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- Mid Section: Wallets Grid (12 cols for beautiful credit cards) -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="glass-card skeleton-card" id="walletsCard">
            <div class="card-header-custom d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="card-title-custom">Hesaplar & Cüzdanlar</h2>
                    <p class="text-muted">Aktif varlık hesaplarınız ve sanal kartlarınız</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#transferModal">Bakiye Transferi</button>
                    <button class="btn btn-indigo btn-sm" onclick="openWalletManagerModal()">Cüzdan Yönetimi</button>
                </div>
            </div>
            
            <div class="row g-3 skeleton-list" style="min-height: 185px;">
                <div class="col-md-4"><div class="skeleton-block w-100" style="height: 185px;"></div></div>
                <div class="col-md-4"><div class="skeleton-block w-100" style="height: 185px;"></div></div>
                <div class="col-md-4"><div class="skeleton-block w-100" style="height: 185px;"></div></div>
            </div>

            <div class="row g-3 text-data-list" id="walletsGrid" style="display:none;">
                <!-- Wallet cards loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- Charts Section: Category Distribution & Asset Allocation side-by-side (6 cols each) -->
<div class="row g-4 mb-4">
    <!-- Kategori Dağılımı (6 cols) -->
    <div class="col-lg-6">
        <div class="chart-card glass-card skeleton-card h-100" id="categoryChartCard">
            <div class="card-header-custom mb-3">
                <h2 class="card-title-custom">Kategori Dağılımı</h2>
                <p class="text-muted">Bu ayki harcamaların dağılımı</p>
            </div>
            <div class="skeleton-block rounded-circle" style="width:120px; height:120px; margin: auto;"></div>
            <div class="chart-container d-flex flex-column align-items-center justify-content-center" style="display:none;">
                <div style="width: 140px; height: 140px;">
                    <canvas id="categoryChart"></canvas>
                </div>
                <div class="category-legend mt-2 w-100" id="catLegend"></div>
            </div>
        </div>
    </div>

    <!-- Varlık Dağılımı (6 cols) -->
    <div class="col-lg-6">
        <div class="chart-card glass-card skeleton-card h-100" id="assetAllocationChartCard">
            <div class="card-header-custom mb-3">
                <h2 class="card-title-custom">Varlık Dağılımı</h2>
                <p class="text-muted">Toplam birikim ve varlıklarınızın cüzdan dağılımı</p>
            </div>
            <div class="skeleton-block rounded-circle" style="width:120px; height:120px; margin: auto;"></div>
            <div class="chart-container d-flex flex-column align-items-center justify-content-center" style="display:none;">
                <div style="width: 140px; height: 140px;">
                    <canvas id="assetAllocationChart"></canvas>
                </div>
                <div class="category-legend mt-2 w-100" id="assetLegend"></div>
            </div>
        </div>
    </div>
</div>

<!-- Akıllı Simülatör Bölümü -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="glass-card border-glow">
            <div class="row g-4 align-items-center">
                <!-- Input Sliders (5 cols) -->
                <div class="col-lg-5">
                    <div class="card-header-custom mb-3">
                        <h2 class="card-title-custom"><i class="fa-solid fa-calculator text-indigo me-2"></i>Akıllı Varlık Simülatörü</h2>
                        <p class="text-muted">Aylık birikim ve bileşik büyüme oranlarınızı simüle ederek geleceğinizi planlayın.</p>
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0 fs-8 text-muted">Aylık Birikim Tutarı</label>
                            <span class="fw-bold text-white fs-7" id="sliderValSavings">3,000 ₺</span>
                        </div>
                        <input type="range" class="custom-range-slider" id="sliderSavings" min="500" max="50000" step="500" value="3000">
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0 fs-8 text-muted">Beklenen Yıllık Büyüme / Faiz Oranı (%)</label>
                            <span class="fw-bold text-white fs-7" id="sliderValGrowth">%35</span>
                        </div>
                        <input type="range" class="custom-range-slider" id="sliderGrowth" min="5" max="80" step="1" value="35">
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0 fs-8 text-muted">Süre (Yıl)</label>
                            <span class="fw-bold text-white fs-7" id="sliderValYears">10 Yıl</span>
                        </div>
                        <input type="range" class="custom-range-slider" id="sliderYears" min="1" max="20" step="1" value="10">
                    </div>
                    
                    <!-- Simulation Stats -->
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <div class="p-2 rounded bg-dark-subtle border border-dark-subtle" style="border-color: rgba(255,255,255,0.02) !important;">
                                <span class="text-muted d-block fs-9" style="font-size: 0.65rem;">TOPLAM ANAPARA</span>
                                <span class="fw-bold text-white fs-7" id="simValPrincipal">360.000 ₺</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded bg-dark-subtle border border-dark-subtle" style="border-color: rgba(255,255,255,0.02) !important;">
                                <span class="text-muted d-block fs-9" style="font-size: 0.65rem;">TAHMİNİ TOPLAM DEĞER</span>
                                <span class="fw-bold text-indigo fs-7" id="simValTotal" style="color: var(--color-indigo) !important;">1.245.670 ₺</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Chart Visualization (7 cols) -->
                <div class="col-lg-7">
                    <div class="chart-container" style="height: 250px; position: relative;">
                        <canvas id="simChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gelişmiş Finansal Analiz & Araçlar (Tabbed Panel) -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="glass-card border-glow">
            <div class="card-header-custom mb-4">
                <h2 class="card-title-custom"><i class="fa-solid fa-gears text-indigo me-2"></i>Gelişmiş Finansal Mühendislik Araçları</h2>
                <p class="text-muted">Portföyünüzü en üst düzeye ulaştırmak için entegre analitik modüller ve simülatörler.</p>
            </div>
            
            <!-- Navigation Tabs -->
            <ul class="nav nav-tabs custom-tabs-nav border-bottom border-dark-subtle mb-4" id="advancedFinanceTabs" role="tablist" style="border-color: rgba(255,255,255,0.05) !important;">
                <li class="nav-item-tab" role="presentation">
                    <button class="nav-link-tab active" id="tab-bes-btn" data-bs-toggle="tab" data-bs-target="#panel-bes" type="button" role="tab" aria-controls="panel-bes" aria-selected="true">
                        <i class="fa-solid fa-shield-halved me-2 text-indigo"></i>BES & Devlet Katkısı
                    </button>
                </li>
                <li class="nav-item-tab" role="presentation">
                    <button class="nav-link-tab" id="tab-tax-btn" data-bs-toggle="tab" data-bs-target="#panel-tax" type="button" role="tab" aria-controls="panel-tax" aria-selected="false">
                        <i class="fa-solid fa-scale-balanced me-2 text-indigo"></i>Vergi Planlayıcı
                    </button>
                </li>
                <li class="nav-item-tab" role="presentation">
                    <button class="nav-link-tab" id="tab-debt-btn" data-bs-toggle="tab" data-bs-target="#panel-debt" type="button" role="tab" aria-controls="panel-debt" aria-selected="false">
                        <i class="fa-solid fa-credit-card me-2 text-indigo"></i>Borç Stratejisti
                    </button>
                </li>
                <li class="nav-item-tab" role="presentation">
                    <button class="nav-link-tab" id="tab-fire-btn" data-bs-toggle="tab" data-bs-target="#panel-fire" type="button" role="tab" aria-controls="panel-fire" aria-selected="false">
                        <i class="fa-solid fa-rocket me-2 text-indigo"></i>FIRE Özgürlük Hesabı
                    </button>
                </li>
                <li class="nav-item-tab" role="presentation">
                    <button class="nav-link-tab" id="tab-exposure-btn" data-bs-toggle="tab" data-bs-target="#panel-exposure" type="button" role="tab" aria-controls="panel-exposure" aria-selected="false">
                        <i class="fa-solid fa-chart-line me-2 text-indigo"></i>Kur & Enflasyon Koruması
                    </button>
                </li>
            </ul>

            <!-- Tab Content Panels -->
            <div class="tab-content" id="advancedFinanceTabContent">
                <!-- 1. BES & Government matching -->
                <div class="tab-pane fade show active" id="panel-bes" role="tabpanel" aria-labelledby="tab-bes-btn">
                    <div class="row g-4">
                        <div class="col-lg-5">
                            <h4 class="text-white fs-7 fw-bold mb-3">BES Tasarruf & Katkı Projeksiyonu</h4>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0 fs-8 text-muted">Aylık Ödeme Tutarı</label>
                                    <span class="fw-bold text-white fs-7" id="besSliderValVal">2.000 ₺</span>
                                </div>
                                <input type="range" class="custom-range-slider" id="besSliderPayment" min="500" max="25000" step="500" value="2000">
                            </div>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0 fs-8 text-muted">Süre (Yıl)</label>
                                    <span class="fw-bold text-white fs-7" id="besSliderValYears">10 Yıl</span>
                                </div>
                                <input type="range" class="custom-range-slider" id="besSliderYears" min="5" max="30" step="1" value="10">
                            </div>
                            
                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <div class="p-2 rounded bg-dark-subtle border border-dark-subtle" style="border-color: rgba(255,255,255,0.02) !important;">
                                        <span class="text-muted d-block fs-9" style="font-size: 0.65rem;">TOPLAM ÖDEMENİZ</span>
                                        <span class="fw-bold text-white fs-7" id="besTotalPrincipal">240.000 ₺</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 rounded bg-dark-subtle border border-dark-subtle" style="border-color: rgba(255,255,255,0.02) !important;">
                                        <span class="text-muted d-block fs-9" style="font-size: 0.65rem;">%30 DEVLET KATKISI</span>
                                        <span class="fw-bold text-success fs-7" id="besTotalGov">72.000 ₺</span>
                                    </div>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="p-2 rounded bg-dark-subtle border border-dark-subtle text-center" style="border-color: rgba(255,255,255,0.02) !important;">
                                        <span class="text-muted d-block fs-9" style="font-size: 0.65rem;">FON GETİRİSİ DAHİL TAHMİNİ BİRİKİM (%35 BÜYÜME)</span>
                                        <span class="fw-bold text-indigo fs-6" id="besEstimatedWealth" style="color: var(--color-indigo) !important;">685.420 ₺</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="chart-container" style="height: 250px; position: relative;">
                                <canvas id="besChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Tax bracket Planner -->
                <div class="tab-pane fade" id="panel-tax" role="tabpanel" aria-labelledby="tab-tax-btn">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h4 class="text-white fs-7 fw-bold mb-3"><i class="fa-solid fa-circle-info text-indigo me-2"></i>Vergi Durum Raporu</h4>
                            <div class="p-3 rounded bg-dark-subtle border border-dark-subtle d-flex flex-column gap-3 mb-2" style="border-color: rgba(255,255,255,0.02) !important;">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted fs-8">Tahmini Brüt Gelir (Yıllık):</span>
                                    <span class="fw-bold text-white fs-8" id="taxAnnualIncome">0 ₺</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted fs-8">Güncel Gelir Vergisi Diliminiz:</span>
                                    <span class="badge bg-danger-soft text-danger fw-bold fs-8" id="taxBracketPercent">%0</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted fs-8">Tahmini Yıllık Gelir Vergisi Yükü:</span>
                                    <span class="fw-bold text-white fs-8" id="taxDueVal">0 ₺</span>
                                </div>
                            </div>
                            <div class="p-2 border-start border-3 border-info bg-info-soft rounded mt-2" style="font-size: 0.72rem;">
                                <i class="fa-solid fa-lightbulb text-info me-2"></i>
                                <span class="text-white">BES katkıları ve yasal sağlık sigorta primleri gelir vergisi matrahınızdan düşülerek verginizi hafifletebilir.</span>
                            </div>
                        </div>
