## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]s/
[Ff]ormat/

# Visual Studio 2015/2017 cache directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/lib/

# Avoid tracking EF migrations cache or DB backups
*.db
*.db-shm
*.db-wal

# User-specific project settings
*.csproj.user
*.userprefs
*.workspace
*.suo

# Publish output
publish/
/publish

# Rider
.idea/
*.sln.iml
